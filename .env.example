# Storage
MODEL_ROOT=/runpod-volume/models
MODEL_MANIFEST=/opt/krea/config/models.json
LORA_CATALOG=/opt/krea/config/lora_catalog.json

# Krea 2 files
KREA_UNET=krea2_turbo_fp8_scaled.safetensors
KREA_TEXT_ENCODER=qwen3vl_4b_fp8_scaled.safetensors
KREA_VAE=qwen_image_vae.safetensors
KREA_MODEL_SHIFT=3.0

# Optional one-time download inside a worker. Prefer preparing the volume beforehand.
AUTO_DOWNLOAD_MODELS=false
DOWNLOAD_GROUPS=core,starter-loras
VERIFY_MODEL_SHA256=false
# HF_TOKEN=hf_xxx

# File-cache preload (enabled by default)
PRELOAD_FILE_CACHE=true
PRELOAD_LORAS=realism,darkbrush
PRELOAD_STRICT=false

# Real one-step ComfyUI warmup (increases cold start)
WARMUP_ON_START=false
WARMUP_LORAS=realism,darkbrush
WARMUP_WIDTH=512
WARMUP_HEIGHT=512
WARMUP_STEPS=1
WARMUP_STRICT=false

# API limits
MAX_MEGAPIXELS=2.1
MAX_TOTAL_MEGAPIXELS=2.1
MAX_BATCH_SIZE=2
MAX_LORAS=4
MAX_PROMPT_CHARS=6000
JOB_TIMEOUT_SECONDS=900
COMFY_POLL_SECONDS=0.35

# Output: auto, base64, s3, or path
OUTPUT_MODE=auto
OUTPUT_ROOT=/tmp/krea-comfy-output
CLEAN_OUTPUTS=true

# Optional external S3 for generated outputs; endpoint must include bucket name.
# BUCKET_ENDPOINT_URL=https://your-bucket.s3.region.amazonaws.com
# BUCKET_ACCESS_KEY_ID=...
# BUCKET_SECRET_ACCESS_KEY=...

# Runtime
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
COMFY_START_TIMEOUT=300
COMFY_LOG_LEVEL=INFO
LOG_LEVEL=INFO
DEBUG_ERRORS=false
